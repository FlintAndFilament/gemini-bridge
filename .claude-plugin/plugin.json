{
  "name": "sidekick",
  "version": "0.3.0",
  "description": "A second opinion from Google Gemini inside Claude Code: review, debug, architect, brainstorm. Run /sidekick:setup after installing.",
  "author": { "name": "FlintAndFilament" },
  "repository": "https://github.com/FlintAndFilament/sidekick",
  "mcpServers": {
    "mcp": {
      "command": "uv",
      "args": ["run", "--frozen", "--quiet", "--project", "${CLAUDE_PLUGIN_ROOT}", "sidekick"],
      "env": { "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv", "PYTHONUNBUFFERED": "1" }
    }
  }
}
